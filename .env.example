# Copy to `.env` (or `.env.local`). Next.js loads both; do not commit real values.
# URLs and integration credentials are configured in Admin and encrypted with
# CONFIG_ENCRYPTION_KEY before persistence. Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# Runtime tuning only.
PROWLARR_TIMEOUT_MS=8000
PROWLARR_MAX_CONCURRENCY=3
JACKETT_TIMEOUT_MS=8000
# Production configuration store (Vercel Marketplace → Upstash Redis).
# Local development stores configuration in .aliasarr/config.json instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
ALIAS_CACHE_TTL_MS=86400000
MAX_TITLES=3
MAX_QUERY_FORMATS_PER_TITLE=2
MAX_PROWLARR_QUERIES=4
SEARCH_RESULT_LIMIT=100
LOG_LEVEL=info

# Admin login (required to edit Gist YAML)
ACCESS_USERNAME=admin
ACCESS_PASSWORD=change-me
# ACCESS_2FA_SECRET=
# Prefer a dedicated high-entropy secret in production (openssl rand -base64 32).
# Falls back to ACCESS_PASSWORD when unset. Production never uses a hardcoded default.
# JWT_SECRET=
JWT_EXPIRES_IN=7d
# SIGNET_SDK_URL=https://vercel-2fa.vercel.app/sdk/signet-client.mjs
# NEXT_PUBLIC_SIGNET_SDK_URL=https://vercel-2fa.vercel.app/sdk/signet-client.mjs
# Optional allowlist (usernames or subject ids). Defaults to ACCESS_USERNAME when unset.
# SIGNET_ALLOWED_USERS=admin
# Note: ACCESS_2FA_SECRET covers password login and Signet SSO (Signet requires a TOTP step-up).
